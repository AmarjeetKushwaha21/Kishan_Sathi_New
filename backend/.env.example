# Server Configuration
PORT=5000
NODE_ENV=production

# Database (MongoDB Atlas required for Vercel deployment)
# Important: In MongoDB Atlas -> Network Access, add IP Address 0.0.0.0/0
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/kishan_sathi?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_super_secret_production_key_random_string_here
JWT_EXPIRES_IN=7d

# Frontend URL for CORS (e.g. your Vercel frontend URL)
CLIENT_URL=https://your-kishan-sathi-frontend.vercel.app
